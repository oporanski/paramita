# Paramita — statyczna strona hodowli. Serwer: Apache.
#
# Jedna wersja domeny jest glowna. Zmierzone 2026-09-26: paramita.pl ORAZ
# www.paramita.pl odpowiadaly 200 bez przekierowania miedzy soba, wiec ta sama
# tresc istniala pod dwoma adresami. Wyszukiwarka nazywa to duplikatem.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.paramita\.pl$ [NC]
  RewriteRule ^(.*)$ https://paramita.pl/$1 [R=301,L]
</IfModule>

# Czyste adresy w katalogach — /zwierzeta/ podaje zwierzeta/index.html.
DirectoryIndex index.html

# ─── Cache ────────────────────────────────────────────────────────────────
#
# Ta strona NIE MA etapu budowania, wiec pliki maja STALE nazwy: `animals.js`
# zawsze nazywa sie `animals.js`. Przy dlugim cache przegladarka trzyma stara
# wersje i poprawka do niej po prostu NIE DOCIERA — nie ma jak jej powiedziec,
# ze plik sie zmienil.
#
# Incydent 2026-09-26: `max-age=604800` (7 dni) na plikach .js sprawilo, ze po
# wgraniu poprawki wlasciciel nadal widzial stary kod. Objawialo sie to jak dwa
# osobne bledy (te same trzy zwierzeta na stronie glownej ORAZ zdjecie, ktore
# miga i zamienia sie w litere), a byla to jedna przyczyna: przegladarka nie
# pobrala nowego `animals.js`.
#
# Dlatego: HTML, CSS i JS **zawsze sie odpytuja**. `no-cache` NIE znaczy "nie
# cachuj" — znaczy "cachuj, ale przed uzyciem zapytaj, czy sie zmienilo".
# Gdy plik jest bez zmian, serwer odpowiada 304 bez tresci (~200 bajtow), wiec
# koszt jest zaden, a caly nasz kod wazy ok. 30 kB.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Obrazy i binarka rozwiazywacza zmieniaja sie rzadko i nie niosa logiki —
# tu dlugi cache jest bezpieczny. Zdjecia zwierzat i tak przychodza z CDN-u
# Velory (images.velora.pet) i podlegaja JEGO naglowkom, nie tym.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/webp                "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType image/x-icon              "access plus 30 days"
  ExpiresByType application/wasm          "access plus 30 days"
</IfModule>

# Cap.js potrzebuje poprawnego typu MIME dla binarki rozwiazywacza — bez tego
# przegladarka odrzuci ja i widget spadnie na wolniejszy wariant w czystym JS.
<IfModule mod_mime.c>
  AddType application/wasm .wasm
</IfModule>

# Kompresja tekstu.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Podstawowe naglowki bezpieczenstwa. Strona nie ma logowania ani ciasteczek,
# wiec to zestaw minimalny, nie rozbudowany.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
